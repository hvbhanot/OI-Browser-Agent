{
  "manifest_version": 3,
  "name": "OpenWebUI Sidekick",
  "version": "1.2.0",
  "description": "Open OpenWebUI in the Chrome side panel and push screenshots/page text from any tab.",
  "permissions": ["sidePanel", "scripting", "activeTab", "tabs", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open OpenWebUI side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "capture-and-send": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture the visible tab and send the screenshot to OpenWebUI."
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}