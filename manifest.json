{
  "manifest_version": 3,
  "name": "Open WebUI Browser Agent",
  "version": "1.8.1",
  "description": "Open WebUI side panel with vision-based browser control, screenshots, and AI page automation.",
  "permissions": ["sidePanel", "scripting", "activeTab", "tabs", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open WebUI Browser Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-agent.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "capture-and-send": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture the visible tab and send the screenshot to Open WebUI."
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}